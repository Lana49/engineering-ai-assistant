USE_LLM=true
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini
# Укажите уже установленную модель из ollama list, например llama3.1:8b.
# Приоритет настроек: переменные окружения > .env > op.env > значения по умолчанию.
USE_EMBEDDINGS=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Пути относительно корня проекта; абсолютные пути тоже поддерживаются.
ENGINEERING_DATA_DIR=data
# Существующая data/embeddings подхватывается автоматически; иначе используется HF-кэш.
# SENTENCE_TRANSFORMERS_HOME=data/embeddings
HF_DATASET_REPO_ID=Lana49/engineering-docs
AUTO_SYNC_DATASET=false
AUTO_REBUILD_INDEX=false
TOP_K=5
MIN_SCORE=0.15
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=120
ALLOW_BUILTIN_CLIMATE_FALLBACK=false

# ИСПРАВЛЕНО: переносимые пути; общий приоритет настроек запуска; без внешних API-ключей.
